# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# field-to-story working output (drafts for human review, not source)
/drafts/

# grants tracker — real pipeline is private (funding strategy); template is committed
/scripts/grants-tracker/pipeline.json

# finance — real ledger + receipts are private; sample + tooling are committed
/finance/ledger.jsonl
/finance/receipts/

# team — real roster is private (personal/contact details); sample is committed
/team/roster.jsonl

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# photos — camera originals are private (location data, full-size faces); see lib/images.ts
/media-originals/
/IMG*.jpg
*.heic
*.HEIC
